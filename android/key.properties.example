# Copy this file to android/key.properties and fill in your own values.
#
# key.properties is git-ignored and must never be committed — it points at your
# signing keystore. See BUILD.md for how to generate one with keytool.
#
# When this file is absent the release build falls back to the debug key so a fresh
# clone still builds; that build must not be distributed.

storeFile=/absolute/path/to/battery-alarm-upload.jks
storePassword=your-store-password
keyAlias=upload
keyPassword=your-key-password
